{
  "name": "@hive/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "cleanup:dev": "tsx watch src/cleanupWorker.ts",
    "cleanup": "node dist/cleanupWorker.js",
    "worker": "node dist/worker.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:integration": "tsx tests/workflowApi.integration.test.ts",
    "test:runner": "tsx --test tests/artifactRange.test.ts tests/artifactCleanupPolicy.test.ts tests/modelRunnerClient.test.ts tests/modelRunnerErrors.test.ts tests/modelParameters.test.ts tests/workflowDefinition.test.ts tests/runDeletionPolicy.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "undici": "^7.30.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
